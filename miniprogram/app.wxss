/* ============================================================
   学材 · 设计系统 (清透天青蓝)
   全局 token + 共用类。保留历史类名，仅升级观感。
   ============================================================ */
page {
  /* 主色 — 清透天青蓝 */
  --brand: #2f7bf6;
  --brand-press: #1f66db;
  --brand-soft: #e8f1fe;
  --brand-ink: #1a5bc4;

  /* 蓝色渐变（顶栏 / 英雄区） */
  --grad-header: linear-gradient(135deg, #d6e8ff 0%, #e8f1fe 55%, #f3f7fc 100%);
  --grad-brand: linear-gradient(135deg, #4a93ff 0%, #2f7bf6 100%);

  /* 彩色强调色 — 分类图标 / 徽标 */
  --c-blue: #2f7bf6;
  --c-amber: #f5a623;
  --c-coral: #fb7a68;
  --c-violet: #8b7cf0;
  --c-pink: #f473b3;

  /* 中性 — 冷白基调 */
  --ink: #141b24;
  --ink-2: #5b6675;
  --ink-3: #94a0b0;
  --line: #eceff4;
  --line-strong: #dce1ea;
  --surface: #ffffff;
  --surface-2: #f8fafd;
  --bg: #f3f6fb;

  /* 语义 */
  --ok-bg: #e8f1fe;
  --ok-ink: #1a5bc4;
  --warn-bg: #fff4e6;
  --warn-ink: #9a5b12;
  --danger-bg: #fdeeea;
  --danger-ink: #b23b2a;

  /* 形状 / 阴影 */
  --r-sm: 14rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-pill: 999rpx;
  --shadow-sm: 0 6rpx 20rpx rgba(26, 59, 110, .06);
  --shadow-md: 0 16rpx 44rpx rgba(26, 59, 110, .09);

  min-height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after { border: 0; }

/* ---------- 布局 ---------- */
.page { padding: 48rpx 36rpx 120rpx; }

.eyebrow {
  display: inline-block;
  color: var(--brand-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}
.title { margin: 20rpx 0 0; font-size: 60rpx; font-weight: 800; line-height: 1.22; letter-spacing: -1rpx; }
.lead { margin: 22rpx 0 48rpx; color: var(--ink-2); font-size: 28rpx; line-height: 1.66; }

/* ---------- 卡片 ---------- */
.card {
  margin-bottom: 24rpx;
  padding: 40rpx 34rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.card-title { margin: 0 0 10rpx; font-size: 36rpx; font-weight: 700; color: var(--ink); }
.muted { color: var(--ink-3); font-size: 25rpx; line-height: 1.6; }

/* ---------- 提示条 ---------- */
.notice {
  margin: 0 0 24rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--ok-bg);
  color: var(--ok-ink);
  font-size: 25rpx;
  line-height: 1.55;
}
.error {
  margin: 0 0 24rpx;
  padding: 22rpx 26rpx;
  border-radius: var(--r-md);
  background: var(--danger-bg);
  color: var(--danger-ink);
  font-size: 25rpx;
  line-height: 1.55;
}

/* ---------- 表单 ---------- */
.field-label { display: block; margin: 32rpx 0 14rpx; color: var(--ink); font-size: 26rpx; font-weight: 600; }
.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 92rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-md);
  background: var(--surface-2);
  color: var(--ink);
  font-size: 29rpx;
}

/* ---------- 按钮 ---------- */
.primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 40rpx 0 0;
  height: 96rpx;
  border-radius: var(--r-md);
  background: var(--grad-brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(47, 123, 246, .26);
  transition: opacity .15s, transform .1s;
}
.primary:active { background: var(--brand-press); transform: scale(.985); }
.primary[disabled] { opacity: .5; box-shadow: none; }
.outline {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 24rpx 0 0;
  height: 92rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: var(--r-md);
  background: var(--surface);
  color: var(--brand-ink);
  font-size: 29rpx;
  font-weight: 500;
  transition: background .15s, transform .1s;
}
.outline:active { background: var(--surface-2); transform: scale(.985); }
.outline[disabled] { opacity: .5; }

/* ---------- 其它共用 ---------- */
.footnote { margin-top: 40rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.66; text-align: center; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 32rpx; }
.toolbar-title { font-size: 44rpx; font-weight: 800; letter-spacing: -.5rpx; }
.small-action {
  padding: 18rpx 26rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
}
.state {
  padding: 96rpx 24rpx;
  color: var(--ink-3);
  font-size: 27rpx;
  line-height: 1.6;
  text-align: center;
}
.tag-pill {
  display: inline-block;
  margin: 10rpx 10rpx 0 0;
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 23rpx;
  font-weight: 500;
}
