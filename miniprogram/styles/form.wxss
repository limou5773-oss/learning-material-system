.form-page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 32rpx calc(210rpx + env(safe-area-inset-bottom)); background: #f5f7fb; }
.form-header { display: flex; align-items: flex-start; gap: 20rpx; padding: 8rpx 4rpx 30rpx; }
.form-header-mark { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border: 1rpx solid #dce9ff; border-radius: 22rpx; background: #eaf2ff; }
.form-header-icon { width: 42rpx; height: 42rpx; background: no-repeat center/contain; }
.form-header-copy { flex: 1; min-width: 0; }
.form-title { color: #243248; font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.form-description { margin-top: 12rpx; color: #8a96a8; font-size: 25rpx; line-height: 1.65; }
.form-panel { margin-bottom: 24rpx; padding: 30rpx; border: 1rpx solid #edf1f7; border-radius: 30rpx; background: #fff; box-shadow: 0 5rpx 18rpx #27467404; }
.form-panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 28rpx; }
.form-panel-title { display: flex; align-items: center; gap: 12rpx; color: #354156; font-size: 29rpx; font-weight: 600; }
.form-panel-title::before { width: 6rpx; height: 26rpx; border-radius: 4rpx; background: #81b0fa; content: ''; }
.form-panel-caption { color: #9ba7b7; font-size: 22rpx; }
.form-field { margin-top: 28rpx; }
.form-field.first-field { margin-top: 0; }
.form-label { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; color: #4b586b; font-size: 26rpx; font-weight: 500; }
.form-optional { color: #a0aaba; font-size: 22rpx; font-weight: 400; }
.form-required { margin-left: 6rpx; color: #df7c7c; }
.form-input, .form-textarea { display: block; box-sizing: border-box; width: 100%; border: 1rpx solid #e4eaf3; border-radius: 22rpx; background: #f8fafd; color: #314159; font-size: 27rpx; }
.form-input { height: 88rpx; padding: 0 24rpx; }
.form-textarea { height: 320rpx; padding: 22rpx 24rpx; line-height: 1.7; }
.form-placeholder { color: #a8b1bf; font-size: 26rpx; }
.form-help { margin-top: 12rpx; color: #9aa6b7; font-size: 23rpx; line-height: 1.65; }
.form-page button.form-primary, .form-page button.form-secondary { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 44rpx; font-size: 28rpx; line-height: 1.4; }
.form-page button.form-primary { border: 0; background: #3385fb; color: #fff; font-weight: 600; }
.form-page button.form-primary:active { background: #2471df; }
.form-page button.form-primary[disabled] { background: #dbe8fc; color: #7b9cc9; opacity: 1; }
.form-page button.form-secondary { border: 1rpx solid #dfe8f6; background: #fff; color: #4b7fc8; font-weight: 400; }
.form-page button.form-secondary:active { background: #edf4ff; }
.form-page button.form-secondary[disabled] { color: #a5b2c5; background: #f5f7fa; }
.form-action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 20rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eaf0f8; background: #fff; box-shadow: 0 -6rpx 24rpx #2b476107; }
.form-action-note { margin-top: 12rpx; color: #9ca8b8; font-size: 22rpx; text-align: center; line-height: 1.5; }
.form-page .error, .form-page .notice { font-size: 24rpx; border-radius: 14rpx; }
.form-page .error { margin-bottom: 24rpx; }
.form-page .notice { margin-bottom: 24rpx; }
.form-page .form-retry { margin-bottom: 24rpx; }
