<wxs module="t">
module.exports.statusClass = function (s) {
  if (s === 'SUCCEEDED') return 's-ok'
  if (s === 'FAILED' || s === 'CANCELLED') return 's-bad'
  if (s === 'WAIT_CONFIRM') return 's-wait'
  return 's-run'
}
</wxs>
<view class="page tasks-page">
  <view class="toolbar"><view class="toolbar-title">整理任务</view></view>
  <view class="lead">查看本人提交的任务与实际状态。生成结果均需人工确认。</view>

  <view wx:if="{{error}}" class="error">{{error}}<view class="retry" bindtap="load">点击重试</view></view>

  <view wx:if="{{loading && !items.length}}" class="card-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-item">
      <view class="sk sk-line w40"></view>
      <view class="sk sk-line w80"></view>
      <view class="sk sk-line w60"></view>
    </view>
  </view>
  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-ico"></view>
    <view class="empty-text">暂无整理任务</view>
    <view class="empty-sub">在资料详情页提交整理任务后会出现在这里</view>
  </view>
  <view wx:else class="card-list">
    <view wx:for="{{items}}" wx:key="id" class="task-item" data-id="{{item.id}}" bindtap="openDetail">
      <view class="ti-top">
        <view class="status-badge {{t.statusClass(item.status)}}">{{item.statusLabel}}</view>
        <text class="ti-date">{{item.shortDate}}</text>
      </view>
      <view class="ti-title">{{item.goalLabel}}</view>
      <view class="ti-meta">资料 #{{item.materialId}} · 版本 {{item.materialVersion}}</view>
      <view wx:if="{{item.errorMessage}}" class="ti-error">{{item.errorMessage}}</view>
    </view>
  </view>

  <view wx:if="{{total > pageSize}}" class="pagination">
    <button bindtap="previous" disabled="{{page === 1 || loading}}">上一页</button>
    <text>第 {{page}} 页 · 共 {{total}} 条</text>
    <button bindtap="next" disabled="{{page * pageSize >= total || loading}}">下一页</button>
  </view>
</view>
