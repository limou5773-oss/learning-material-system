<view class="page form-page confirmation-page">
  <view class="confirmation-heading"><view class="form-title">确认整理结果</view><view class="form-description">核对来源，挑选知识，经你确认后保存。</view></view>
  <view wx:if="{{generationView}}" class="notice generation-notice">{{generationView.label}}<view wx:if="{{generationView.modelLabel}}">{{generationView.modelLabel}}</view><view>{{generationView.warning}}</view></view>
  <view wx:if="{{loading}}" class="state">正在读取候选…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{draftWarning}}" class="notice">{{draftWarning}}</view>
  <button wx:if="{{!loading && !task && error}}" class="form-secondary" bindtap="load">重新加载</button>
  <view wx:if="{{restored && !receipt}}" class="notice">已恢复当前账号的编辑草稿。</view>
  <view wx:if="{{receipt}}" class="form-panel"><view class="form-section-title">已保存 {{receipt.cardIds.length}} 张卡片</view><view class="form-help">资料版本更新为 {{receipt.resultingMaterialVersion}}，重复提交不会创建副本。</view><button wx:for="{{receipt.cardIds}}" wx:key="*this" class="form-secondary saved-card" data-id="{{item}}" bindtap="openCard">查看卡片 #{{item}}</button></view>
  <block wx:elif="{{cards.length}}">
    <view wx:if="{{task.status === 'SUCCEEDED'}}" class="notice">任务已完成，可读取上次保存结果，不会再次创建卡片。</view>
    <view wx:for="{{warnings}}" wx:key="*this" class="notice">{{item}}</view>
    <view class="review-steps"><view wx:for="{{stepLabels}}" wx:key="*this" class="review-step {{index === currentStep ? 'current' : ''}} {{index < currentStep ? 'passed' : ''}}"><view class="step-number">{{index < currentStep ? '✓' : index + 1}}</view><text>{{item}}</text></view></view>
    <view class="version-label">第 {{currentStep + 1}} / 3 步 · 候选版本 {{resultVersion}} · 来源版本 {{sourceVersion}}</view>
    <view wx:if="{{conflict}}" class="form-panel draft-panel">
      <view class="form-section-title">保留的编辑草稿</view><view class="form-help">可长按选择复制；版本冲突解决前不会保存。</view>
      <text selectable="true">摘要：{{summary}}\n资料标签：{{tagsText}}</text>
      <view wx:for="{{cards}}" wx:for-item="draftCard" wx:key="candidateKey" class="draft-copy"><text selectable="true">{{draftCard.selected ? '已选择' : '未选择'}}\n标题：{{draftCard.title}}\n正文：{{draftCard.content}}\n卡片标签：{{draftCard.tagsText}}</text></view>
    </view>
    <block wx:if="{{currentStep === 0}}">
      <view class="form-panel">
        <view class="form-section-title">核对摘要与标签</view>
        <view class="form-field"><label class="form-label" for="confirm-summary">资料摘要</label><textarea id="confirm-summary" class="form-textarea summary-textarea" value="{{summary}}" maxlength="4000" bindinput="onSummaryInput" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" /><view class="field-count">{{summary.length}} / 4000 字</view></view>
        <view class="form-field"><label class="form-label" for="confirm-tags">资料标签</label><input id="confirm-tags" class="form-input" value="{{tagsText}}" maxlength="650" bindinput="onTagsInput" placeholder="多个标签用逗号分隔" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" /><view class="form-help">最多 10 个标签，每个最多 64 字。</view></view>
        <view class="form-field"><view class="form-label">标签保存方式</view><radio-group class="tag-modes" bindchange="onTagModeChange"><label class="mode"><radio value="MERGE" color="#3385fb" checked="{{tagMode === 'MERGE'}}" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" />合并原标签</label><label class="mode"><radio value="REPLACE" color="#3385fb" checked="{{tagMode === 'REPLACE'}}" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" />替换原标签</label></radio-group></view>
      </view>
      <view class="form-panel source-panel"><view class="form-section-title">完整来源对照</view><view class="form-help">对照原文检查摘要，尤其留意 OCR 识别提示。</view><view wx:for="{{sources}}" wx:key="chunkId" class="confirm-source"><view class="source-label">片段 #{{item.chunkId}} · {{item.locator}}</view><view wx:if="{{item.qualityNote}}" class="notice">{{item.qualityNote}}</view><text selectable="true">{{item.content}}</text></view><view wx:if="{{!sources.length}}" class="form-help">暂无来源片段，请返回任务详情核查。</view></view>
    </block>
    <block wx:elif="{{currentStep === 1}}">
      <view class="selection-heading"><view class="form-section-title">挑选要保存的卡片</view><text>已选 {{selectedCount}} / {{cards.length}} 张</text></view><view class="selection-help">可修改选中卡片；未选择父卡片时，子卡片会保存为根节点。</view>
      <checkbox-group bindchange="onCardSelection"><view wx:for="{{cards}}" wx:for-item="card" wx:key="candidateKey" class="form-panel confirm-card {{card.selected ? '' : 'not-selected'}}">
        <label class="card-selection"><checkbox value="{{card.candidateKey}}" color="#3385fb" checked="{{card.selected}}" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" />保存此卡片<text>候选 {{index + 1}}</text></label>
        <view class="form-field"><label class="form-label" for="candidate-title-{{index}}">标题</label><input id="candidate-title-{{index}}" class="form-input" value="{{card.title}}" maxlength="255" data-key="{{card.candidateKey}}" data-field="title" bindinput="onCardInput" disabled="{{!card.selected || conflict || saving || task.status !== 'WAIT_CONFIRM'}}" /></view>
        <view class="form-field"><label class="form-label" for="candidate-content-{{index}}">正文</label><textarea id="candidate-content-{{index}}" class="form-textarea card-textarea" value="{{card.content}}" maxlength="8000" data-key="{{card.candidateKey}}" data-field="content" bindinput="onCardInput" disabled="{{!card.selected || conflict || saving || task.status !== 'WAIT_CONFIRM'}}" /></view>
        <view class="form-field"><label class="form-label" for="candidate-tags-{{index}}">卡片标签</label><input id="candidate-tags-{{index}}" class="form-input" value="{{card.tagsText}}" maxlength="650" data-key="{{card.candidateKey}}" data-field="tagsText" bindinput="onCardInput" disabled="{{!card.selected || conflict || saving || task.status !== 'WAIT_CONFIRM'}}" /></view>
        <view wx:for="{{card.sources}}" wx:for-item="source" wx:key="chunkId" class="confirm-source"><view class="source-label">来源片段 #{{source.chunkId}}</view><text selectable="true">{{source.quoteText}}</text></view>
      </view></checkbox-group>
    </block>
    <block wx:else>
      <view class="form-panel save-overview"><view class="form-section-title">最后核对</view><view class="save-card-count">{{selectedCount}}<text>张知识卡片待保存</text></view><view class="review-caption">资料摘要</view><text class="summary-preview" selectable="true">{{summary || '未填写摘要'}}</text><view class="review-caption">资料标签 · {{tagMode === 'REPLACE' ? '替换原标签' : '合并原标签'}}</view><text class="summary-preview" selectable="true">{{tagsText || '未添加标签'}}</text><view class="form-help">需要调整摘要或卡片时，可点击上一步，已有修改会保留。</view></view>
      <view class="form-panel"><view class="form-section-title">关联建议<text class="form-optional">选填</text></view><view class="form-help">核对关系与依据后再勾选，未勾选的关联不会保存。</view><checkbox-group bindchange="onRelationSelection"><label wx:for="{{relations}}" wx:key="relationKey" class="relation"><view><checkbox value="{{item.relationKey}}" color="#3385fb" checked="{{item.selected}}" disabled="{{conflict || saving || task.status !== 'WAIT_CONFIRM'}}" />{{item.typeLabel}}</view><view class="relation-endpoints">起点：{{item.sourceLabel}} {{item.connector}} 终点：{{item.targetLabel}}</view><view class="source-label">{{item.directionLabel}}</view><text selectable="true">{{item.evidenceText}}</text></label></checkbox-group><view wx:if="{{!relations.length}}" class="form-help">本次没有关联建议，可直接保存选中卡片。</view></view>
    </block>
    <view class="step-actions"><button wx:if="{{currentStep > 0}}" class="form-secondary" bindtap="previousStep" disabled="{{saving || loading}}">上一步</button><button wx:if="{{currentStep < 2}}" class="form-primary" bindtap="nextStep" disabled="{{saving || loading || conflict}}">{{currentStep === 0 ? '下一步：选择卡片' : '下一步：核对关联'}}</button><button wx:else class="form-primary" bindtap="submit" loading="{{saving}}" disabled="{{saving || loading || conflict || !selectedCount}}">{{task.status === 'SUCCEEDED' ? '读取上次保存结果' : '确认保存'}}</button></view>
  </block>
  <button class="form-secondary return-task" bindtap="openTask" disabled="{{saving}}">返回任务详情</button>
</view>
