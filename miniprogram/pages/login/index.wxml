<view class="login-page">
  <view class="brand">
    <view class="brand-badge"></view>
    <view class="brand-name">智能学习资料整理平台</view>
    <view class="brand-sub">基于大模型 · 双端协同</view>
  </view>

  <view class="form">
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <view wx:if="{{checkingSession}}" class="muted session-hint">正在验证登录状态…</view>

    <button class="primary" bindtap="submitWechat" loading="{{loading && loginMethod === 'wechat'}}" disabled="{{loading || checkingSession}}">微信一键登录</button>
    <button class="text-toggle" bindtap="togglePasswordLogin" disabled="{{loading || checkingSession}}" aria-expanded="{{showPasswordLogin}}">{{showPasswordLogin ? '收起账号密码登录' : '使用账号密码登录'}}</button>

    <view wx:if="{{showPasswordLogin}}" class="password-panel">
      <text class="field-label">用户名</text>
      <input class="field-input" value="{{username}}" bindinput="onUsernameInput" placeholder="请输入用户名" maxlength="32" disabled="{{loading || checkingSession}}" aria-label="用户名" placeholder-style="color:#a0aab8" />
      <text class="field-label">密码</text>
      <input class="field-input" value="{{password}}" bindinput="onPasswordInput" placeholder="请输入密码" password="true" maxlength="64" disabled="{{loading || checkingSession}}" aria-label="密码" placeholder-style="color:#a0aab8" />
      <button class="primary submit-password" bindtap="submit" loading="{{loading && loginMethod === 'password'}}" disabled="{{loading || checkingSession}}">登录</button>
    </view>
  </view>

  <view class="footnote">仅首次绑定需先用已有账号登录，绑定后直接微信登录。新账号请先在 Web 端注册。</view>
</view>
