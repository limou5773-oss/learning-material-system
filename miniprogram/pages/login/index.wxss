.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 44rpx 56rpx;
  background: linear-gradient(180deg, #d6e8ff 0%, #e4effd 26%, #eef4fc 52%, #f3f6fb 100%);
}

.hero { padding: 0 4rpx 44rpx; }
.brand-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 40rpx;
  border-radius: 28rpx;
  background: var(--grad-brand);
  color: #fff;
  font-size: 54rpx;
  font-weight: 800;
  box-shadow: 0 18rpx 36rpx rgba(47, 123, 246, .32);
}
.hero .title { font-size: 56rpx; }
.hero .lead { margin-bottom: 0; }

.login-card {
  margin: 0;
  padding: 48rpx 40rpx;
  border: 0;
  border-radius: 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(26, 59, 110, .12);
}
.login-card .muted { margin-bottom: 28rpx; }
.login-card .notice,
.login-card .error { margin-top: 28rpx; margin-bottom: 0; }
.session-hint { margin-top: 24rpx; }

.wechat-login { margin-top: 32rpx; }
.wechat-glyph { margin-right: 14rpx; font-size: 30rpx; }
.login-alternative { margin-top: 20rpx; }

.password-panel {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.footnote { margin-top: auto; padding-top: 56rpx; }
