.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 56rpx 64rpx;
  background: var(--surface);
}

/* ---------- 品牌区（居中克制） ---------- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 168rpx 0 112rpx;
}
.brand-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background-color: var(--brand);
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 60rpx 60rpx;
  box-shadow: 0 14rpx 30rpx rgba(47, 123, 246, .28);
}
.brand-name { margin-top: 40rpx; font-size: 42rpx; font-weight: 700; letter-spacing: .5rpx; }
.brand-sub { margin-top: 16rpx; color: var(--ink-3); font-size: 25rpx; letter-spacing: 1rpx; }

/* ---------- 表单 ---------- */
.form { width: 100%; }
.session-hint { margin-bottom: 24rpx; text-align: center; }
.notice, .error { margin-bottom: 24rpx; }

.primary { height: 92rpx; font-size: 31rpx; }

.text-toggle {
  display: block;
  width: 100%;
  margin: 32rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--brand);
  font-size: 27rpx;
  font-weight: 500;
  text-align: center;
}
.text-toggle::after { border: 0; }
.text-toggle[disabled] { opacity: .5; }

.password-panel { margin-top: 24rpx; }
.submit-password { margin-top: 44rpx; }

.footnote {
  margin-top: auto;
  padding-top: 64rpx;
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.7;
}
