.filters { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 28rpx; }
.filter { margin: 0; padding: 14rpx 26rpx; border: 1rpx solid var(--line-strong); border-radius: var(--r-pill); background: var(--surface); color: var(--brand-ink); font-size: 25rpx; line-height: 1.5; }
.filter.active { background: var(--brand); border-color: var(--brand); color: #fff; }
.filter.refresh { margin-left: auto; }
.notification { margin-top: 20rpx; padding: 32rpx; }
.notification.unread { border-left: 6rpx solid var(--brand); }
.notification-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.notification-title { font-size: 32rpx; font-weight: 700; }
.read-state { color: var(--ink-3); font-size: 24rpx; }
.notification-content { display: block; margin: 22rpx 0; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.notification-actions { display: flex; gap: 16rpx; }
.notification-actions button { flex: 1; width: auto; height: 78rpx; margin-top: 28rpx; font-size: 25rpx; }
.pagination { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 32rpx; color: var(--ink-3); font-size: 23rpx; }
.pagination button { margin: 0; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; border-radius: var(--r-pill); background: var(--surface); box-shadow: var(--shadow-sm); color: var(--brand-ink); font-size: 24rpx; }
button[disabled] { opacity: .55; }
