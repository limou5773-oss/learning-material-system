.materials-page { padding-top: 36rpx; }

/* ---------- 列表卡片（资料专属） ---------- */
.note-list { margin-top: 28rpx; }
.note-item {
  margin-bottom: 20rpx;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.note-item:active { background: var(--surface-2); }
.note-item-top { display: flex; align-items: center; gap: 14rpx; }
.type-badge {
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  font-size: 21rpx;
  font-weight: 700;
}
.b-note { background: var(--brand-soft); color: var(--brand-ink); }
.b-image { background: #ecebfe; color: #6b5bd0; }
.b-pdf { background: #fdecea; color: #c7472e; }
.arch-tag { color: var(--ink-3); font-size: 22rpx; }
.note-date { margin-left: auto; color: var(--ink-3); font-size: 23rpx; }
.note-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.note-excerpt { margin-top: 10rpx; overflow: hidden; color: var(--ink-2); font-size: 25rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.note-foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 18rpx; }
.note-meta { flex: 1; min-width: 0; }
.subject-tag { display: inline-block; color: var(--ink-3); font-size: 23rpx; }
.fav-btn {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 30rpx;
}
.fav-btn.on { color: #f5a623; }
