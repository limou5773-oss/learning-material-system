<view class="page">
  <view class="toolbar"><view class="toolbar-title">我的资料</view><view class="toolbar-actions"><view class="small-action" bindtap="newNote">＋ 写笔记</view><view class="small-action secondary-action" bindtap="newImage">上传图片</view></view></view>
  <view class="filter-card">
    <input class="field-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索标题或正文" maxlength="100" />
    <input class="field-input subject-input" value="{{subject}}" bindinput="onSubjectInput" placeholder="筛选学科" maxlength="64" />
    <view class="filter-actions"><picker range="{{tagNames}}" value="{{tagIndex}}" bindchange="onTagChange"><view class="tag-picker">{{tagNames[tagIndex]}} ▾</view></picker><picker range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatusChange"><view class="tag-picker">{{statusNames[statusIndex]}} ▾</view></picker><button class="filter-button" bindtap="search">搜索</button></view>
    <view class="favorite-filter"><text>只看收藏</text><switch checked="{{favoritesOnly}}" bindchange="onFavoriteChange" color="#276c47" /></view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}<view class="retry" bindtap="load">点击重试</view></view>
  <view wx:if="{{loading}}" class="state">正在加载资料…</view>
  <view wx:elif="{{!items.length}}" class="state">这里还没有符合条件的资料。</view>
  <view wx:else class="note-list">
    <view wx:for="{{items}}" wx:key="id" class="note-item" data-id="{{item.id}}" bindtap="openDetail">
      <view class="note-item-top"><text class="note-type">{{item.type === 'IMAGE' ? '图片资料' : item.type === 'PDF' ? 'PDF 资料' : '文字笔记'}}{{item.status === 'ARCHIVED' ? ' · 已归档' : ''}}</text><text class="note-date">{{item.shortDate}}</text></view>
      <view class="note-title">{{item.title}}</view>
      <view class="note-excerpt">{{item.type === 'IMAGE' ? '打开查看原图' : item.type === 'PDF' ? '打开预览 PDF' : item.excerpt}}</view>
      <view class="note-meta"><text>{{item.subject || '未分类'}}</text><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id" class="tag-pill">#{{tag.name}}</text></view>
      <button class="favorite-button" data-id="{{item.id}}" disabled="{{favoriteBusyId === item.id}}" catchtap="toggleFavorite">{{item.favorite ? '★ 已收藏' : '☆ 收藏'}}</button>
    </view>
  </view>
  <view wx:if="{{total > pageSize}}" class="pagination"><button bindtap="previous" disabled="{{page === 1 || loading}}">上一页</button><text>第 {{page}} 页 / 共 {{total}} 条</text><button bindtap="next" disabled="{{page * pageSize >= total || loading}}">下一页</button></view>
</view>
