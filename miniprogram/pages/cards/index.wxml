<view class="page cards-page">
  <view class="toolbar">
    <view class="toolbar-title">知识卡片</view>
  </view>

  <view class="search-bar">
    <view class="search-ico"></view>
    <input class="search-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索标题或正文" placeholder-style="color:#a0aab8" maxlength="100" confirm-type="search" bindconfirm="search" />
    <view class="search-btn" bindtap="search">搜索</view>
  </view>

  <view class="filter-row">
    <input class="filter-input" value="{{subject}}" bindinput="onSubjectInput" placeholder="学科" placeholder-style="color:#a0aab8" maxlength="64" />
    <input class="filter-input" value="{{tag}}" bindinput="onTagInput" placeholder="标签" placeholder-style="color:#a0aab8" maxlength="64" />
    <view class="fav-toggle {{favoriteOnly ? 'on' : ''}}" bindtap="toggleFavFilter">★ 收藏</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}<view class="retry" bindtap="load">点击重试</view></view>

  <view wx:if="{{loading}}" class="card-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-item">
      <view class="sk sk-line w40"></view>
      <view class="sk sk-line w80"></view>
      <view class="sk sk-line w60"></view>
    </view>
  </view>
  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-ico"></view>
    <view class="empty-text">没有符合条件的卡片</view>
    <view class="empty-sub">调整筛选条件，或点底部“＋”新建卡片</view>
  </view>
  <view wx:else class="card-list">
    <view wx:for="{{items}}" wx:key="id" class="knowledge-card" data-id="{{item.id}}" bindtap="openCard">
      <view class="kc-top">
        <text class="kc-label">{{item.generationLabel}}</text>
        <text wx:if="{{item.favorite}}" class="kc-fav">★</text>
      </view>
      <view class="kc-title">{{item.title}}</view>
      <view class="kc-preview">{{item.summary || item.content}}</view>
      <view wx:if="{{item.subject || item.tags.length}}" class="kc-meta">
        <text wx:if="{{item.subject}}" class="subject-tag">{{item.subject}}</text>
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag-pill">#{{tag}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{total > 20}}" class="pagination">
    <button disabled="{{loading || page === 1}}" bindtap="previous">上一页</button>
    <text>第 {{page}} 页 · 共 {{total}} 张</text>
    <button disabled="{{loading || page * 20 >= total}}" bindtap="next">下一页</button>
  </view>
</view>
