.cards-page { padding-top: 36rpx; }

.card-list { margin-top: 28rpx; }
.knowledge-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 32rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--brand);
}
.knowledge-card:active { background: var(--surface-2); }
.kc-top { display: flex; align-items: center; justify-content: space-between; }
.kc-label { color: var(--brand-ink); font-size: 22rpx; font-weight: 600; }
.kc-fav { color: #f5a623; font-size: 28rpx; }
.kc-title { margin-top: 14rpx; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.kc-preview {
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.kc-meta { margin-top: 16rpx; }
.subject-tag { display: inline-block; margin-right: 10rpx; color: var(--ink-3); font-size: 23rpx; }
