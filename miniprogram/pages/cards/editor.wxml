<view class="page"><text class="eyebrow">KNOWLEDGE CARD</text><view class="title">{{id ? '编辑知识卡片' : '人工创建卡片'}}</view>
  <view class="lead">{{id ? '修改正文后，原来源仍为创建时的历史依据。' : '写下自己的学习要点，人工卡片无自动来源。'}}</view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!ready && !loading}}" class="outline" bindtap="load">重试加载</button>
  <view wx:if="{{ready}}" class="card">
    <view wx:if="{{restored}}" class="notice">已恢复当前账号的本机草稿。</view>
    <view wx:if="{{draftError}}" class="error">{{draftError}}</view>
    <view wx:if="{{id}}" class="muted">正在编辑版本 {{editingVersion}}</view>
    <view wx:if="{{conflict}}" class="server-copy"><view>当前服务器版本 {{currentVersion || '待读取'}}；下方草稿未被替换。</view>
      <view wx:if="{{serverError}}" class="error">{{serverError}}</view>
      <button class="outline" bindtap="loadServerCopy" loading="{{serverLoading}}" disabled="{{serverLoading}}">{{serverCopy ? '刷新服务器版本' : '重试读取服务器版本'}}</button>
      <block wx:if="{{serverCopy}}"><view class="field-label">服务器版本 {{serverCopy.version}}：{{serverCopy.title}}</view><text class="server-content" selectable="true">{{serverCopy.content}}</text><view class="muted">摘要：{{serverCopy.summary || '无'}} · 学科：{{serverCopy.subject || '无'}} · 标签：{{serverCopy.tags}}</view>
        <button class="outline" bindtap="discardDraft" disabled="{{serverLoading}}">放弃草稿，使用服务器版本</button></block>
    </view>
    <label for="card-title" class="field-label">标题</label><input id="card-title" aria-label="标题" class="field-input" value="{{title}}" disabled="{{saving}}" bindinput="onTitleInput" maxlength="255" />
    <label for="card-subject" class="field-label">学科（可选）</label><input id="card-subject" aria-label="学科" class="field-input" value="{{subject}}" disabled="{{saving}}" bindinput="onSubjectInput" maxlength="64" />
    <label for="card-tags" class="field-label">标签（可选）</label><input id="card-tags" aria-label="标签，多个标签用逗号隔开" class="field-input" value="{{tagsText}}" disabled="{{saving}}" bindinput="onTagsInput" maxlength="1000" placeholder="多个标签用逗号隔开" />
    <view class="muted">修改标签文本后将按中英文逗号重新分隔；保持文本不变会保留原有标签。</view>
    <label for="card-summary" class="field-label">摘要（可选）</label><textarea id="card-summary" aria-label="摘要" class="card-textarea summary-textarea" value="{{summary}}" disabled="{{saving}}" bindinput="onSummaryInput" maxlength="2000" />
    <label for="card-content" class="field-label">正文</label><textarea id="card-content" aria-label="正文" class="card-textarea" value="{{content}}" disabled="{{saving}}" bindinput="onContentInput" maxlength="8000" />
    <view class="character-count">{{content.length}} / 8000 字{{changed ? ' · 未保存' : ''}}</view>
    <button class="primary" bindtap="submit" loading="{{saving}}" disabled="{{saving || conflict}}">{{id ? '保存修改' : '创建卡片'}}</button>
  </view>
</view>
