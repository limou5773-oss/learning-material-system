<view class="page form-page card-editor-page {{conflict ? 'is-conflict' : ''}}">
  <view class="form-header">
    <view class="form-header-mark"><view class="form-header-icon card-icon"></view></view>
    <view class="form-header-copy"><view class="form-title">{{id ? '编辑知识卡片' : '新建知识卡片'}}</view><view class="form-description">{{id ? '修改内容后，仍保留创建时的历史来源。' : '用自己的话记录学习要点，方便随时回顾。'}}</view></view>
  </view>
  <view wx:if="{{loading}}" class="state">正在加载…</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <button wx:if="{{!ready && !loading}}" class="form-secondary form-retry" bindtap="load">重试加载</button>
  <block wx:if="{{ready}}">
    <view wx:if="{{restored}}" class="notice">已恢复当前账号的本机草稿。</view>
    <view wx:if="{{draftError}}" class="error" role="alert">{{draftError}}</view>
    <view wx:if="{{conflict}}" class="form-panel server-copy">
      <view class="form-panel-heading"><view class="form-panel-title">版本需要核对</view></view>
      <view class="server-description">服务器版本 {{currentVersion || '待读取'}}，当前草稿已保留，请先对照内容。</view>
      <view wx:if="{{serverError}}" class="error">{{serverError}}</view>
      <button class="form-secondary" bindtap="loadServerCopy" loading="{{serverLoading}}" disabled="{{serverLoading}}">{{serverCopy ? '刷新服务器版本' : '重试读取服务器版本'}}</button>
      <block wx:if="{{serverCopy}}">
        <view class="server-title">版本 {{serverCopy.version}} · {{serverCopy.title}}</view>
        <text class="server-content" selectable="true">{{serverCopy.content}}</text>
        <view class="form-help">摘要：{{serverCopy.summary || '无'}} · 学科：{{serverCopy.subject || '无'}} · 标签：{{serverCopy.tags}}</view>
        <button class="form-secondary" bindtap="discardDraft" disabled="{{serverLoading}}">放弃草稿，使用服务器版本</button>
      </block>
    </view>
    <view class="form-panel editor-form">
      <view class="form-field first-field">
        <label for="card-title" class="form-label"><text>卡片标题<text class="form-required">*</text></text><text wx:if="{{id}}" class="form-optional">版本 {{editingVersion}}</text></label>
        <input id="card-title" aria-label="标题" class="form-input" value="{{title}}" disabled="{{saving}}" bindinput="onTitleInput" maxlength="255" placeholder="给知识点起一个清晰的标题" placeholder-class="form-placeholder" />
      </view>
      <view class="editor-meta">
        <view class="form-field">
          <label for="card-subject" class="form-label"><text>学科</text><text class="form-optional">选填</text></label>
          <input id="card-subject" aria-label="学科" class="form-input" value="{{subject}}" disabled="{{saving}}" bindinput="onSubjectInput" maxlength="64" placeholder="例如：计算机网络" placeholder-class="form-placeholder" />
        </view>
        <view class="form-field">
          <label for="card-tags" class="form-label"><text>标签</text><text class="form-optional">选填</text></label>
          <input id="card-tags" aria-label="标签，多个标签用逗号隔开" class="form-input" value="{{tagsText}}" disabled="{{saving}}" bindinput="onTagsInput" maxlength="1000" placeholder="用逗号分隔多个标签" placeholder-class="form-placeholder" />
        </view>
      </view>
      <view wx:if="{{id}}" class="editor-tags-help">修改标签会更新原标签，保持不变则保留。</view>
      <view class="form-field editor-summary">
        <label for="card-summary" class="form-label"><text>摘要</text><text class="form-optional">选填</text></label>
        <textarea id="card-summary" aria-label="摘要" class="form-textarea summary-textarea" value="{{summary}}" disabled="{{saving}}" bindinput="onSummaryInput" maxlength="2000" placeholder="用一两句话概括核心内容" placeholder-class="form-placeholder" />
      </view>
      <view class="form-field editor-content">
        <label for="card-content" class="form-label"><text>正文<text class="form-required">*</text></text><text class="form-optional">{{content.length}} / 8000 字</text></label>
        <textarea id="card-content" aria-label="正文" class="form-textarea" value="{{content}}" disabled="{{saving}}" bindinput="onContentInput" maxlength="8000" placeholder="记录概念、理解、例题或需要记住的知识点…" placeholder-class="form-placeholder" />
      </view>
    </view>
    <view class="form-action-bar">
      <button class="form-primary" bindtap="submit" loading="{{saving}}" disabled="{{saving || conflict}}">{{id ? '保存修改' : '创建卡片'}}</button>
      <view class="form-action-note">{{conflict ? '请先核对服务器版本，再继续保存' : changed ? '有未保存的修改' : id ? '修改完成后请保存' : '手动创建的卡片不附自动来源'}}</view>
    </view>
  </block>
</view>
