# Create a separate, empty MySQL database before starting the backend.
DB_URL='jdbc:mysql://127.0.0.1:3306/learning_material_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=
DB_PASSWORD=
# Optional: files default to the current user's ~/.learning-material-system/files directory.
# STORAGE_ROOT=/absolute/path/outside/repository
# FILE_MAX_IMAGE_BYTES=10485760
# FILE_MAX_PDF_BYTES=31457280
# Optional: keep off until a task processor is installed in D11.
# TASK_WORKER_ENABLED=false
# OCR is opt-in. Only Tencent GeneralBasicOCR is implemented in D14.
# OCR_ENABLED=false
# OCR_PROVIDER=tencent
# OCR_SECRET_ID=
# OCR_SECRET_KEY=
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY=
# TASK_PROCESSOR_MODE=model
